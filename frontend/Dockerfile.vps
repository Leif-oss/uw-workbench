# Frontend Dockerfile - Multi-stage build for VPS deployment
# Stage 1: Build
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY . .

# Build argument for API URL (set via docker-compose build args)
ARG VITE_API_URL=http://localhost/api
ENV VITE_API_URL=$VITE_API_URL

# Build the application
RUN npm run build

# Stage 2: Serve with nginx
FROM nginx:alpine

# Install security updates
RUN apk update && apk upgrade && apk add --no-cache \
    && rm -rf /var/cache/apk/*

# Copy built files from builder
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy nginx configuration (fixed port for VPS)
COPY nginx.conf.vps /etc/nginx/conf.d/default.conf

# Create non-root user (nginx already runs as nginx user, but ensure proper permissions)
RUN chown -R nginx:nginx /usr/share/nginx/html && \
    chmod -R 755 /usr/share/nginx/html

# Expose port 3000 (internal, Caddy proxies to this)
EXPOSE 3000

# Start nginx (already runs as nginx user by default)
CMD ["nginx", "-g", "daemon off;"]
