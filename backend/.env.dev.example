# Backend Environment Configuration - DEV CLOUD
# These values are set via Cloud Run environment variables and Secret Manager
# This file is for documentation only - values are set during deployment

# Database Configuration (Cloud SQL)
# These are set as Cloud Run environment variables:
# DB_USER=postgres
# DB_NAME=uw_workbench
# CLOUD_SQL_CONNECTION_NAME=ultra-ace-481723-e6:us-central1:uw-workbench-db-dev
# DB_PASSWORD is retrieved from Secret Manager secret: db-password-dev

# Secrets (stored in Secret Manager with -dev suffix):
# AI_API_KEY from secret: ai-api-key-dev
# DB_PASSWORD from secret: db-password-dev
# SMTP_HOST from secret: smtp-host-dev
# SMTP_PORT from secret: smtp-port-dev
# SMTP_USER from secret: smtp-user-dev
# SMTP_PASSWORD from secret: smtp-password-dev
# SMTP_FROM_EMAIL from secret: smtp-from-email-dev
# SMTP_FROM_NAME from secret: smtp-from-name-dev

# Environment Variables (set during deployment):
# ENVIRONMENT=development
# TEMP_SETUP_MODE=true
# CORS_ORIGINS (set after frontend deployment)

# Note: DATABASE_URL is NOT set - backend uses Cloud SQL connection config
# (DB_USER, DB_NAME, CLOUD_SQL_CONNECTION_NAME, DB_PASSWORD)
