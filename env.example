# UW Workbench - VPS Deployment Environment Variables
# Copy this file to .env and fill in your actual values
# NEVER commit .env to Git!

# =============================================================================
# Database Configuration
# =============================================================================
POSTGRES_USER=uw_workbench
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD
POSTGRES_DB=uw_workbench

# =============================================================================
# Application URLs
# =============================================================================
# Your domain or IP address (for CORS and email links)
# Examples:
#   - With domain: https://workbench.example.com
#   - With IP: http://YOUR_VPS_IP
#   - For testing: http://localhost
FRONTEND_URL=https://workbench.example.com

# CORS allowed origins (comma-separated)
# Set to your actual domain(s) in production
# Examples:
#   - Single domain: https://workbench.example.com
#   - Multiple: https://workbench.example.com,https://www.example.com
CORS_ORIGINS=https://workbench.example.com

# Frontend API URL (used during build)
# This should point to your backend API endpoint
# Format: {FRONTEND_URL}/api
# Examples:
#   - With domain: https://workbench.example.com/api
#   - With IP: http://YOUR_VPS_IP/api
VITE_API_URL=https://workbench.example.com/api

# =============================================================================
# AI Configuration (Optional - for AI features)
# =============================================================================
# Get your API key from: https://platform.openai.com/api-keys
AI_API_KEY=sk-your-openai-api-key-here

# =============================================================================
# Email Configuration (Optional - for email notifications)
# =============================================================================
# SMTP server settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=UW Workbench

# =============================================================================
# Caddy Domain Configuration
# =============================================================================
# For production with a domain, set this in Caddyfile
# For testing with IP only, use :80 in Caddyfile
# DOMAIN is set in Caddyfile, not here

# =============================================================================
# Security Notes
# =============================================================================
# 1. Use strong passwords for POSTGRES_PASSWORD
# 2. Never commit .env to Git
# 3. Rotate secrets if accidentally committed
# 4. Use HTTPS in production (Caddy handles this automatically)
# 5. Restrict CORS_ORIGINS to your actual domain(s)
